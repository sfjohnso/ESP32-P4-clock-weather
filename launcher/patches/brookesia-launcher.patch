+// Time sync: start SNTP once the first address arrives (the Settings app used to do this, with a
+// Chinese server and China time; the time zone comes from user_config.h now).
+static void start_time_sync()
+{
+    if (esp_sntp_enabled()) {
+        return;
+    }
+    esp_sntp_setoperatingmode(SNTP_OPMODE_POLL);
+    esp_sntp_setservername(0, "pool.ntp.org");
+    esp_sntp_init();
+    ESP_LOGI(ESP_UTILS_LOG_TAG, "SNTP time sync started");
+}
